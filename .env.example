# Copy to .env. Only these names are read; anything else in .env is ignored.

# Any OpenAI-compatible chat endpoint. DeepSeek shown; examples for others in the README.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# $ per 1M tokens. Set both to meter spend and enforce --budget.
LLM_PRICE_IN=0.30
LLM_PRICE_OUT=1.20
# Optional JSON merged into each request (provider-specific options).
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Your Fortuna API key (FORTUNA-...), created at https://fortuna.cc/settings/keys. Sent as a bearer token.
FORTUNA_API_KEY=
